---
import Layout from '../layouts/Layout.astro';
import JikeOriginalLink from '../components/JikeOriginalLink.astro';
import { getCollection } from 'astro:content';
import { notePlainText, resolveJikeOriginalUrl } from '../lib/jike-note.mjs';

const posts = (await getCollection('posts')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const latest = posts[0];

const latestNoteEntry = (await getCollection('notes'))
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())[0];

const latestNote = latestNoteEntry
	? {
			date: latestNoteEntry.data.date,
			originalUrl: resolveJikeOriginalUrl({
				jikePostId: latestNoteEntry.data.jikePostId,
				body: latestNoteEntry.body,
			}),
			snippet: (() => {
				const text = notePlainText(latestNoteEntry.body);
				if (text.length <= 140) return text;
				return `${text.slice(0, 140).replace(/\s+\S*$/, '')}…`;
			})(),
		}
	: null;

const libraryItems = (await getCollection('library'))
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
	.slice(0, 4);

const coverSrc = (cover?: { src: string } | string) =>
	typeof cover === 'string' ? cover : cover?.src;

const typeStamp = {
	music: 'Music',
	video: 'Video',
	book: 'Book',
} as const;
---

<Layout title="Kangyuan's Blog">
	<div class="home max-w-3xl pt-4 md:pt-20 pb-24">
		<header class="masthead">
			<h1 class="font-serif font-normal tracking-tight text-text-light dark:text-text-dark leading-[1.05] text-[2.4rem] sm:text-5xl md:text-6xl">
				Hammer Seeking Nails
			</h1>
			<p class="slogan-line mt-6 md:mt-8 font-serif italic text-[1.35rem] sm:text-2xl md:text-[2.05rem] leading-snug" aria-label="Logic, Emotion, Elegance">
				<span class="slogan-word" style="animation-delay: 0s">Logic</span>
				<span class="slogan-dot" aria-hidden="true">·</span>
				<span class="slogan-word" style="animation-delay: 2.2s">Emotion</span>
				<span class="slogan-dot" aria-hidden="true">·</span>
				<span class="slogan-word" style="animation-delay: 4.4s">Elegance</span>
			</p>
		</header>

		{latest && (
			<article class="feature mt-24 md:mt-36">
				<div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-[11px] font-medium uppercase tracking-[0.22em] text-text-muted-light dark:text-text-muted-dark">
					<span class="text-primary">Essay</span>
					<span class="h-px w-8 bg-primary/80" aria-hidden="true"></span>
					{latest.data.category && <span>{latest.data.category}</span>}
					<time datetime={latest.data.pubDate.toISOString()}>
						{latest.data.pubDate.toLocaleDateString('zh-CN', {
							year: 'numeric',
							month: 'long',
							day: 'numeric',
						})}
					</time>
				</div>

				<h2 class="mt-6 font-serif font-normal text-[1.7rem] leading-[1.35] sm:text-3xl md:text-[2.2rem] text-text-light dark:text-text-dark text-balance">
					<a href={`/posts/${latest.slug}/`} class="hover:text-primary transition-colors duration-300">
						{latest.data.title}
					</a>
				</h2>

				<p class="mt-5 max-w-lg font-serif text-base md:text-lg leading-[1.7] text-text-light/75 dark:text-text-dark/75">
					{latest.data.description}
				</p>

				<div class="mt-10 flex items-baseline justify-between gap-8 border-t border-black/10 dark:border-white/10 pt-6">
					<a href={`/posts/${latest.slug}/`} class="group inline-flex items-center gap-2 font-serif text-lg text-text-light dark:text-text-dark hover:text-primary transition-colors">
						阅读这篇
						<span class="transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">&rarr;</span>
					</a>
					<a href="/blog" class="text-[11px] font-medium uppercase tracking-[0.2em] text-text-muted-light dark:text-text-muted-dark hover:text-primary transition-colors">
						全部文章
					</a>
				</div>
			</article>
		)}

		{latestNote && (
			<section class="note-mag mt-24 md:mt-32" aria-label="Latest note">
				<article class="note-spread">
					<time class="note-date" datetime={latestNote.date.toISOString()}>
						{latestNote.date.toLocaleDateString('zh-CN', {
							year: 'numeric',
							month: 'long',
							day: 'numeric',
						})}
					</time>

					<div class="note-quote-row">
						<p class="note-quote">{latestNote.snippet || '一条新闪念'}</p>
						{latestNote.originalUrl && <JikeOriginalLink href={latestNote.originalUrl} />}
					</div>

					<a href="/notes" class="note-more">
						<span class="note-more-zh">看看我在想些什么</span>
					</a>
				</article>
			</section>
		)}

		<section class="studio mt-24 md:mt-32" aria-label="Library">
			<div class="studio-head">
				<p class="stamp">Library</p>
				<a href="/library" class="studio-more">完整收藏</a>
			</div>

			<div class="shelf" data-shelf>
				{libraryItems.map((item, index) => {
					const src = coverSrc(item.data.coverImage);
					const subtitle = item.data.type === 'music'
						? item.data.artist
						: item.data.type === 'book'
							? item.data.author
							: item.data.source;
					return (
						<a
							href="/library"
							class="cover"
							style={`--i: ${index}; --bob-delay: ${index * 0.4}s`}
							data-title={item.data.title}
							data-sub={subtitle || typeStamp[item.data.type]}
							data-kind={typeStamp[item.data.type]}
						>
							<span class="cover-stamp">{typeStamp[item.data.type]}</span>
							{src ? (
								<img src={src} alt={item.data.title} loading="lazy" />
							) : (
								<span class="cover-fallback">{item.data.title.slice(0, 1)}</span>
							)}
						</a>
					);
				})}
			</div>

			<div class="shelf-caption" data-shelf-caption>
				<p class="shelf-kind" data-shelf-kind>{typeStamp[libraryItems[0]?.data.type ?? 'book']}</p>
				<p class="shelf-title" data-shelf-title>{libraryItems[0]?.data.title}</p>
				<p class="shelf-sub" data-shelf-sub>
					{libraryItems[0]?.data.type === 'music'
						? libraryItems[0]?.data.artist
						: libraryItems[0]?.data.type === 'book'
							? libraryItems[0]?.data.author
							: libraryItems[0]?.data.source}
				</p>
			</div>
		</section>
	</div>
</Layout>

<script>
	function initShelfCaption() {
		const shelf = document.querySelector('[data-shelf]');
		const kind = document.querySelector('[data-shelf-kind]');
		const title = document.querySelector('[data-shelf-title]');
		const sub = document.querySelector('[data-shelf-sub]');
		if (!(shelf instanceof HTMLElement) || !kind || !title || !sub || shelf.dataset.ready) return;
		shelf.dataset.ready = 'true';

		const apply = (cover: Element | null) => {
			if (!(cover instanceof HTMLElement)) return;
			kind.textContent = cover.dataset.kind || '';
			title.textContent = cover.dataset.title || '';
			sub.textContent = cover.dataset.sub || '';
		};

		shelf.querySelectorAll('.cover').forEach((cover) => {
			cover.addEventListener('mouseenter', () => apply(cover));
			cover.addEventListener('focus', () => apply(cover));
		});
	}

	document.addEventListener('astro:page-load', initShelfCaption);
</script>

<style>
	.home {
		--ink: #1a1a1a;
		--paper: #fffdf8;
		--scrap: #fff8ec;
		--hot: #d00000;
	}

	:global(.dark) .home {
		--ink: #f3f0e7;
		--paper: #1c1c21;
		--scrap: #26232b;
	}

	.masthead {
		animation: mast-in 1s ease both;
	}

	.feature,
	.note-mag,
	.studio {
		animation: mast-in 1.05s ease 0.18s both;
	}

	.slogan-line {
		--quiet: #555555;
		--hot: #d00000;
	}

	:global(.dark) .slogan-line {
		--quiet: #a1a1aa;
	}

	.slogan-word {
		display: inline-block;
		color: var(--quiet);
		opacity: 0.45;
		animation: slogan-speak 6.6s ease-in-out infinite;
	}

	.slogan-dot {
		display: inline-block;
		margin-inline: 0.4em;
		color: var(--quiet);
		opacity: 0.4;
	}

	/* Notes: magazine spread */
	.note-spread {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		padding-top: 0.35rem;
		border-top: 1px solid color-mix(in srgb, var(--ink) 14%, transparent);
	}

	.note-date {
		display: block;
		font-size: 0.7rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: color-mix(in srgb, var(--ink) 48%, transparent);
	}

	.note-quote-row {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 1rem 1.5rem;
	}

	.note-quote {
		margin: 0;
		flex: 1 1 auto;
		min-width: 0;
		font-family: "EB Garamond", "Noto Serif SC", serif;
		font-size: clamp(0.98rem, 1.35vw, 1.12rem);
		line-height: 1.75;
		color: color-mix(in srgb, var(--ink) 82%, transparent);
		text-wrap: pretty;
	}

	.note-more {
		display: inline-flex;
		flex-direction: column;
		align-items: flex-end;
		align-self: flex-end;
		gap: 0.2rem;
		margin-top: 0.35rem;
		text-decoration: none;
		color: #777;
		transition: color 0.2s ease, transform 0.2s ease;
	}

	.note-more-zh {
		font-size: 0.68rem;
		font-weight: 600;
		letter-spacing: 0.18em;
		transition: color 0.2s ease;
	}

	.note-more:hover,
	.note-more:focus-visible {
		color: var(--hot);
		transform: translateX(2px);
		outline: none;
	}

	:global(.dark) .note-more {
		color: #a1a1aa;
	}

	/* Library */
	.studio-head {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 1.5rem;
	}

	.stamp {
		display: inline-block;
		margin: 0;
		padding: 0.18rem 0.58rem 0.12rem;
		border: 1.5px dashed var(--hot);
		border-radius: 0.55rem 0.95rem 0.45rem 0.85rem / 0.75rem 0.5rem 0.9rem 0.55rem;
		color: var(--hot);
		font-family: "EB Garamond", "Noto Serif SC", serif;
		font-size: 0.78rem;
		font-style: italic;
		font-weight: 500;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		transform: rotate(-4deg);
		opacity: 0.92;
	}

	.studio-more {
		font-size: 0.68rem;
		font-weight: 600;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: #777;
		transition: color 0.2s ease, transform 0.2s ease;
	}

	.studio-more:hover {
		color: var(--hot);
		transform: translateX(2px);
	}

	.shelf {
		position: relative;
		height: 16rem;
		margin-top: 0.35rem;
		isolation: isolate;
	}

	.cover {
		--spread: 4.55rem;
		--tilt: calc((var(--i) - 1.5) * 7deg);
		position: absolute;
		top: 1.35rem;
		left: 50%;
		width: clamp(7.4rem, 21vw, 9.2rem);
		aspect-ratio: 1;
		overflow: hidden;
		border: 1.75px solid color-mix(in srgb, var(--ink) 82%, transparent);
		border-radius: 1.05rem 1.35rem 0.95rem 1.25rem / 1.2rem 0.95rem 1.35rem 1.05rem;
		background: var(--paper);
		box-shadow:
			3px 3px 0 color-mix(in srgb, var(--ink) 55%, transparent),
			0 0 0 1px color-mix(in srgb, var(--ink) 8%, transparent);
		transform:
			translateX(calc(-50% + (var(--i) - 1.5) * var(--spread)))
			rotate(var(--tilt))
			translateY(0)
			scale(1);
		transform-origin: 50% 85%;
		animation: cover-bob 3.4s ease-in-out var(--bob-delay) infinite;
		transition:
			transform 0.38s cubic-bezier(0.22, 1.15, 0.28, 1),
			box-shadow 0.38s ease,
			filter 0.38s ease,
			z-index 0s;
		z-index: calc(10 + var(--i));
	}

	.cover img,
	.cover-fallback {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.cover-fallback {
		display: grid;
		place-items: center;
		font-family: "EB Garamond", "Noto Serif SC", serif;
		font-size: 2.5rem;
		background: #f3e7d4;
		color: var(--hot);
	}

	.cover-stamp {
		position: absolute;
		top: 0.5rem;
		left: 0.5rem;
		z-index: 2;
		padding: 0.12rem 0.42rem 0.08rem;
		border: 1.5px dashed color-mix(in srgb, var(--ink) 70%, transparent);
		border-radius: 0.45rem 0.75rem 0.4rem 0.7rem / 0.65rem 0.4rem 0.75rem 0.45rem;
		background: color-mix(in srgb, var(--scrap) 92%, white);
		color: color-mix(in srgb, var(--ink) 78%, transparent);
		font-family: "EB Garamond", "Noto Serif SC", serif;
		font-size: 0.62rem;
		font-style: italic;
		font-weight: 500;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		transform: rotate(-6deg);
		box-shadow: 1.5px 1.5px 0 color-mix(in srgb, var(--ink) 28%, transparent);
	}

	:global(.dark) .cover-stamp {
		background: #2b2730;
	}

	/* Dock-like focus: hovered grows, neighbors ease aside and shrink a little */
	.shelf:hover .cover,
	.shelf:focus-within .cover {
		--spread: 5.35rem;
		animation-play-state: paused;
		filter: saturate(0.88) brightness(0.97);
		transform:
			translateX(calc(-50% + (var(--i) - 1.5) * var(--spread)))
			rotate(calc((var(--i) - 1.5) * 3deg))
			translateY(-0.2rem)
			scale(0.92);
	}

	.cover:hover,
	.cover:focus-visible {
		z-index: 40;
		filter: none;
		box-shadow:
			5px 7px 0 color-mix(in srgb, var(--ink) 45%, transparent),
			0 14px 28px color-mix(in srgb, var(--ink) 12%, transparent);
		transform:
			translateX(calc(-50% + (var(--i) - 1.5) * var(--spread)))
			rotate(-1deg)
			translateY(-1.15rem)
			scale(1.2);
		outline: none;
	}

	.shelf-caption {
		margin-top: 1.2rem;
		text-align: center;
		min-height: 4.5rem;
	}

	.shelf-kind {
		margin: 0;
		color: var(--hot);
		font-family: "EB Garamond", "Noto Serif SC", serif;
		font-size: 0.78rem;
		font-style: italic;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.shelf-title {
		margin: 0.4rem 0 0;
		font-family: "EB Garamond", "Noto Serif SC", serif;
		font-size: 1.15rem;
		line-height: 1.3;
	}

	.shelf-sub {
		margin: 0.25rem 0 0;
		color: #777;
		font-size: 0.92rem;
	}

	:global(.dark) .shelf-sub {
		color: #a1a1aa;
	}

	@keyframes mast-in {
		from {
			opacity: 0;
			transform: translateY(0.7rem);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}

	@keyframes slogan-speak {
		0%,
		42%,
		100% {
			color: var(--quiet);
			opacity: 0.45;
			transform: translateY(0);
		}
		12%,
		28% {
			color: var(--hot);
			opacity: 1;
			transform: translateY(-0.08em);
		}
	}

	@keyframes cover-bob {
		0%,
		100% {
			transform:
				translateX(calc(-50% + (var(--i) - 1.5) * var(--spread)))
				rotate(var(--tilt))
				translateY(0)
				scale(1);
		}
		50% {
			transform:
				translateX(calc(-50% + (var(--i) - 1.5) * var(--spread)))
				rotate(calc(var(--tilt) + 1.1deg))
				translateY(-0.42rem)
				scale(1);
		}
	}

	@media (max-width: 768px) {
		.shelf {
			height: 13.5rem;
		}

		.cover {
			--spread: 2.85rem;
			width: 6.35rem;
		}

		.shelf:hover .cover,
		.shelf:focus-within .cover {
			--spread: 3.35rem;
		}

		.cover:hover,
		.cover:focus-visible {
			transform:
				translateX(calc(-50% + (var(--i) - 1.5) * var(--spread)))
				rotate(-1deg)
				translateY(-0.85rem)
				scale(1.14);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.masthead,
		.feature,
		.note-mag,
		.studio,
		.slogan-word,
		.cover {
			animation: none;
		}

		.slogan-word {
			color: var(--hot);
			opacity: 1;
		}

		.cover {
			transform:
				translateX(calc(-50% + (var(--i) - 1.5) * var(--spread)))
				rotate(var(--tilt));
		}
	}
</style>
