---
interface Props {
    href: string;
}

const { href } = Astro.props;
---

<a class="jike-original" href={href} target="_blank" rel="noopener noreferrer">查看原文</a>

<style>
    .jike-original {
        flex: 0 0 auto;
        align-self: flex-end;
        margin: 0 0 0.12rem;
        padding: 0.12rem 0.55rem 0.14rem;
        border: 1px solid color-mix(in srgb, currentColor 22%, transparent);
        border-radius: 999px;
        background: transparent;
        color: #777;
        font-size: 0.68rem;
        font-weight: 600;
        line-height: 1.4;
        letter-spacing: 0.06em;
        text-decoration: none;
        white-space: nowrap;
        transition: color 0.2s ease, border-color 0.2s ease;
    }

    .jike-original:hover,
    .jike-original:focus-visible {
        color: #d00000;
        border-color: #d00000;
        outline: none;
    }

    :global(.dark) .jike-original {
        color: #a1a1aa;
    }

    :global(.dark) .jike-original:hover,
    :global(.dark) .jike-original:focus-visible {
        color: #ff5a5a;
        border-color: #ff5a5a;
    }
</style>
